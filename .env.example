# ===================================================
# TRAVALLY - ENVIRONMENT CONFIGURATION TEMPLATE
# For local development (.env) and Vercel Deployment
# ===================================================

NODE_ENV="production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Travally"

# Database Configuration (MongoDB Atlas Cloud)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<appName>
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xlo2iiv.mongodb.net/travally?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xlo2iiv.mongodb.net/travally?retryWrites=true&w=majority&appName=Cluster0"

# Authentication & Session Security
JWT_SECRET="your-super-secure-random-jwt-secret-key"
SESSION_EXPIRY_DAYS="7"

# Authentication Provider
AUTH_PROVIDER="local"

# LinkedIn OAuth 2.0 (Optional)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI=""

NEXT_PUBLIC_SUPPORT_EMAIL="support@travally.app"
