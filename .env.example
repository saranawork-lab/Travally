# ==============================================================================
# MITRAIL PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mitrail"

# Database Configuration
# Default: Local SQLite for seamless zero-setup MVP testing
DATABASE_URL="file:./dev.db"
# For Cloud/Supabase PostgreSQL deployment, uncomment and update:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres"

# Authentication & Session Security
JWT_SECRET="replace-with-a-random-32-character-secret"
SESSION_EXPIRY_DAYS="7"

# External Authentication Providers (Ready for your credentials)
AUTH_PROVIDER="local"

# Supabase Auth Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# LinkedIn OAuth Integration (Optional profile connection)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/callback/linkedin"

# External Identity Verification Provider
IDENTITY_VERIFICATION_PROVIDER=""
IDENTITY_VERIFICATION_API_KEY=""

# Email Service Provider
EMAIL_FROM="welcome@mitrail.app"
RESEND_API_KEY=""

# Public Safety & Support Contact
NEXT_PUBLIC_SUPPORT_EMAIL="support@mitrail.app"
